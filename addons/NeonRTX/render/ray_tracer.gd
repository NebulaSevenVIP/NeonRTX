func refract_ray(
	incident : Vector3,
	normal : Vector3,
	ior := 1.5
) -> Vector3:

	var cosi = clamp(
		incident.dot(normal),
		-1.0,
		1.0
	)

	var etai = 1.0
	var etat = ior

	var n = normal

	if cosi < 0.0:

		cosi = -cosi

	else:

		var temp = etai

		etai = etat
		etat = temp

		n = -normal

	var eta = etai / etat

	var k = 1.0 - eta * eta * (
		1.0 - cosi * cosi
	)

	if k < 0.0:
		return Vector3.ZERO

	return (

		incident * eta +

		n * (
			eta * cosi - sqrt(k)
		)

	).normalized()


func random_hemisphere(
	normal : Vector3
) -> Vector3:

	var dir = Vector3(

		rng.randf_range(-1.0, 1.0),

		rng.randf_range(-1.0, 1.0),

		rng.randf_range(-1.0, 1.0)

	).normalized()

	if dir.dot(normal) < 0.0:
		dir = -dir

	return dir.normalized()

func get_hit_color(hit : Dictionary) -> Color:

	if hit.is_empty():
		return Color.WHITE

	var collider = hit.collider

	if collider == null:
		return Color.WHITE

	if collider.has_meta("rtx_color"):

		return collider.get_meta(
			"rtx_color"
		)

	return Color.WHITE

func get_hit_alpha(hit : Dictionary) -> float:

	if hit.is_empty():
		return 1.0

	var collider = hit.collider

	if collider == null:
		return 1.0

	if collider.has_meta("rtx_alpha"):

		return collider.get_meta(
			"rtx_alpha"
		)

	return 1.0

func is_glass(hit : Dictionary) -> bool:

	if hit.is_empty():
		return false

	var collider = hit.collider

	if collider == null:
		return false

	if collider.has_meta("rtx_glass"):

		return collider.get_meta(
			"rtx_glass"
		)

	return false

func path_trace(
	origin : Vector3,
	direction : Vector3,
	bounces := 16
) -> Color:

	var result : Color = Color.BLACK

	var energy : Color = Color.WHITE

	var pos : Vector3 = origin

	var dir : Vector3 = direction.normalized()

	for i in range(bounces):

		var hit = shoot_ray(
			pos,
			dir
		)

		if hit.is_empty():

			result += energy * Color(
				0.5,
				0.7,
				1.0
			)

			break

		var normal = hit.normal

		var hit_pos = hit.position

