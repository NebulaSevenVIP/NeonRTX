func shoot_ray(
	origin : Vector3,
	direction : Vector3,
	max_distance := 1000.0
) -> Dictionary:

	var query = PhysicsRayQueryParameters3D.create(

		origin,

		origin + direction.normalized() * max_distance
	)

	query.collide_with_areas = false
	query.collide_with_bodies = true

	return space_state.intersect_ray(query)

