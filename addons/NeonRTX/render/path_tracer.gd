func setup(rt):

	ray_tracer = rt

	rng.randomize()

func trace(
	origin : Vector3,
	direction : Vector3,
	bounces := 4
) -> Color:

	var energy = Color.WHITE

	var result = Color.BLACK

	var pos = origin
	var dir = direction.normalized()

	for i in range(bounces):

		var hit = ray_tracer.shoot_ray(
			pos,
			dir
		)

		if hit.is_empty():

			result += energy * Color(
				0.5,
				0.7,
				1.0
			)

			break

		var normal : Vector3 = hit.normal

		pos = hit.position + normal * 0.001

		dir = random_hemisphere(normal)

		energy *= 0.7

		result += energy

	return result

func random_hemisphere(
	normal : Vector3
) -> Vector3:

	var dir = Vector3(

		rng.randf_range(-1.0, 1.0),

		rng.randf_range(-1.0, 1.0),

		rng.randf_range(-1.0, 1.0)
